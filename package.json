{
  "name": "wisplet",
  "version": "0.4.0",
  "description": "Keyboard-first app launcher overlay for Windows 11",
  "homepage": "https://github.com/greyfox-be/wisplet",
  "repository": {
    "type": "git",
    "url": "https://github.com/greyfox-be/wisplet.git"
  },
  "bugs": "https://github.com/greyfox-be/wisplet/issues",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
