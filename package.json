    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "@tauri-apps/cli": "^2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
